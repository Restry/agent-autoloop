+export function prepareArtifacts(home,run,attempt,cwd,rule){const root=rootFor(home,run,attempt),file=path.join(root,'baseline.json');if(fs.existsSync(file))return;const base=scan(cwd);json(file,{cwd:fs.realpathSync(cwd),rule,at:new Date().toISOString(),...base});json(path.join(root,'index.json'),{run,attempt,rule,status:'collecting',files:[],warnings:base.warnings});}
