+/** Only prior attempts of this run may supply scratch handoff notes. */
+export function retryScratchFolders(folder: string): string[] {
+  const current = /^(\d+)-(\d+)$/.exec(path.basename(folder));
+  const parent = path.dirname(folder);
+  if (!current || path.basename(parent) !== "runs" || !existsSync(parent)) return [];
+  const root = realpathSync(parent);
+  return readdirSync(parent).flatMap((name) => {
+    const prior = /^(\d+)-(\d+)$/.exec(name);
+    if (!prior || prior[1] !== current[1] || Number(prior[2]) >= Number(current[2])) return [];
+    const scratch = path.join(parent, name, "scratch");
+    try {
+      const info = lstatSync(scratch);
+      return info.isDirectory() && !info.isSymbolicLink() && realpathSync(scratch).startsWith(root + path.sep)
+        ? [scratch]
+        : [];
+    } catch { return []; }
+  });
+}
